generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

model Task {
  id        String     @id @default(uuid()) @db.Uuid
  title     String     @db.Text
  status    TaskStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
